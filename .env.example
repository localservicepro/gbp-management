# GoHighLevel Private Integration Token (Settings > Private Integrations) with scopes:
# contacts.write, contacts.readonly, locations/customFields.write, locations/customFields.readonly,
# invoices.write, invoices.readonly, invoices/schedule.write, invoices/schedule.readonly, users.readonly
GHL_PIT_TOKEN=
# The sub-account (location) ID the contacts, custom fields and invoices live in
GHL_LOCATION_ID=
# Optional: GHL user ID the invoice is sent "from". Falls back to the first user found in the location.
GHL_USER_ID=
# Optional: secret used to sign the links between steps. Falls back to a hash of the PIT token.
APP_SECRET=
# Optional: public base URL of this deployment (used in invoice notes). Vercel sets VERCEL_URL automatically.
APP_URL=
