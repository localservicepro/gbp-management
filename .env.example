# GoHighLevel Private Integration Token (Settings > Private Integrations) with scopes:
# contacts.write, contacts.readonly, locations/customFields.write, locations/customFields.readonly,
# invoices.write, invoices.readonly, invoices/schedule.write, invoices/schedule.readonly, users.readonly
GHL_PIT_TOKEN=
# The sub-account (location) ID the contacts, custom fields and invoices live in
GHL_LOCATION_ID=
# Optional: GHL user ID the invoice is sent "from". Falls back to the first user found in the location.
GHL_USER_ID=
# Optional: secret used to sign the links between steps. Falls back to a hash of the PIT token.
APP_SECRET=
# Optional: white-label GHL app domain, used for the "pay invoice" link stored on the contact and the
# contact deep links in the internal email / ClickUp task. Defaults to https://login.localservicepro.com.au
GHL_APP_BASE_URL=
# Optional: only if invoice pages are served from a different domain than the app (check GHL > invoice > Copy link).
GHL_INVOICE_BASE_URL=
# Optional: public base URL of this deployment (used in invoice notes). Vercel sets VERCEL_URL automatically.
APP_URL=
# ClickUp personal API token (Settings > Apps > API Token, starts with "pk_"). When set, every signed
# client gets a task in Operations > New Project > GBP Optimisation. Leave blank to disable.
CLICKUP_API_TOKEN=
# Optional: override the target list. Defaults to the GBP Optimisation list (1300390000006185).
CLICKUP_LIST_ID=
